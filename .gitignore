# FramePulse – root .gitignore

# --- Dependencies -------------------------------------------------------------
node_modules/
.venv/
venv/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Expo / React Native ----------------------------------------------------
.expo/
.expo-shared/
dist/
web-build/
*.tsbuildinfo
.metro-health-check*

# Generated native Android project (Expo continuous native generation)
mobile-app/android/

# --- Local configuration and secrets ---------------------------------------
# All .env files are local; .env.example (the pattern without secrets) stays.
.env*
!.env.example
!**/.env.example
pc-agent/config.json

# --- PresentMon (stahuje setup.bat / download_presentmon.py) -----------------
pc-agent/tools/PresentMon.exe

# --- Temporary, logging and system files -----------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*~
.cache/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# PyInstaller build output (pc-agent/build_exe.bat); dist/ is ignored above
build/
*.spec
